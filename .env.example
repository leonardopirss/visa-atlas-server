DATABASE_URL=postgresql://visa_atlas:visa_atlas@localhost:5432/visa_atlas?schema=public
DATABASE_POOL_MAX=5
DATABASE_REPLICA_COUNT=2
DATABASE_GLOBAL_CONNECTION_BUDGET=15
DATABASE_POOL_TIMEOUT_MS=2000
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_QUERY_CONCURRENCY=2
DATABASE_QUERY_QUEUE_MAX=8
DATABASE_QUERY_QUEUE_TIMEOUT_MS=250
# Opcional. Quando ausente, os testes derivam automaticamente o schema public_test.
TEST_DATABASE_URL=postgresql://visa_atlas:visa_atlas@localhost:5432/visa_atlas?schema=public_test
PORT=3000
CORS_ORIGINS=http://localhost:5173
# Production example: api.example.com. Keep disabled for local development.
CLOUDFLARE_ORIGIN_LOCK_ENABLED=false
CLOUDFLARE_ALLOWED_HOSTS=
# Comma-separated values from https://www.cloudflare.com/ips-v4 and /ips-v6.
CLOUDFLARE_IP_RANGES=
CACHE_TTL_SECONDS=60
CACHE_ENABLED=false
CACHE_DEFAULT_TTL_SECONDS=900
CACHE_MAX_ITEM_BYTES=131072
CACHE_TTL_JITTER_PERCENT=10
CACHE_LOCK_TTL_MS=2000
CACHE_LOCK_WAIT_MS=250
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MODE=observe
RATE_LIMIT_IDENTITY_SECRET=replace-with-at-least-32-random-characters
RATE_LIMIT_HEAVY_MAX=60
RATE_LIMIT_DAILY_MAX=1000
# Configure explicit trusted Nginx hop/network before accepting forwarded client IPs.
TRUST_PROXY=false
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=1000
REDIS_COMMAND_TIMEOUT_MS=250
REDIS_KEY_PREFIX=visa-atlas:development
REDIS_CIRCUIT_FAILURE_THRESHOLD=5
REDIS_CIRCUIT_RESET_MS=10000
REDIS_RECONNECT_MAX_DELAY_MS=1000
REDIS_RECONNECT_MAX_ATTEMPTS=3
